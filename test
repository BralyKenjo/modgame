local isLoading = false
OpenBtn.MouseButton1Click:Connect(function()
    if isLoading then return end

    if not keyVerified then
        ShowToast("🔒 Vui lòng nhập đúng key trước khi mở script!", C.Red)
        Bounce(KeyCard)
        local blink = 0
        local conn
        conn = RunService.Heartbeat:Connect(function()
            blink = blink + 1
            KeyStroke.Transparency = (blink % 10 < 5) and 0 or 0.8
            if blink > 40 then
                KeyStroke.Transparency = 0.15
                conn:Disconnect()
            end
        end)
        return
    end

    isLoading = true
    Bounce(OpenBtn)
    HideError()
    SetButtonState("loading")
    ShowToast("⏳ Đang tải Chilli x Venyx V10...", C.Amber)

    task.spawn(function()
        local ok, result, e = pcall(LoadMainScript)
        local success, errInfo
        if not ok then success, errInfo = false, ClassifyRuntime(result)
        else success, errInfo = result, e end

        if success then
            SetButtonState("success")
            ShowToast("✅ Đã tải xong! Hãy chọn menu Chilli hoặc Venyx", C.Green)
            task.wait(CONFIG.AutoHideDelay)
            CloseMenu()
        else
            SetButtonState("failed")
            ShowError(errInfo)
            ShowToast("❌ " .. errInfo.title, C.Red)
            warn("[ChilliVenyx Loader] " .. BuildReport(errInfo))
            task.delay(2.5, function()
                if OpenBtn and OpenBtn.Parent then
                    SetButtonState("idle")
                    isLoading = false
                end
            end)
        end
    end)
end)

